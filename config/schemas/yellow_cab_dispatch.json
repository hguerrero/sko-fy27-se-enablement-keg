{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Yellow Cab Dispatch Event",
  "description": "NYC yellow cab dispatch event from the 1999 New York simulation layer",
  "type": "object",
  "properties": {
    "cab_id": {
      "type": "string",
      "description": "Unique cab identifier",
      "pattern": "^NYC-[0-9]{4}$"
    },
    "zone": {
      "type": "string",
      "description": "Dispatch zone within New York City",
      "enum": [
        "Manhattan-Midtown", "Manhattan-Downtown", "Manhattan-Uptown",
        "Brooklyn-Heights", "Queens-Astoria", "Bronx-Fordham",
        "Staten-Island-Ferry", "JFK-Airport", "LaGuardia-Airport"
      ]
    },
    "status": {
      "type": "string",
      "description": "Current dispatch status",
      "enum": ["dispatched", "en_route", "arrived", "completed", "cancelled"]
    },
    "passengers": {
      "type": "integer",
      "description": "Number of passengers",
      "minimum": 1,
      "maximum": 4
    },
    "fare_usd": {
      "type": "number",
      "description": "Fare amount in USD",
      "minimum": 5
    },
    "distance_miles": {
      "type": "number",
      "description": "Trip distance in miles",
      "minimum": 0.5
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 event timestamp",
      "format": "date-time"
    }
  },
  "required": ["cab_id", "zone", "status", "passengers", "fare_usd", "distance_miles", "timestamp"],
  "additionalProperties": false,
  "examples": [
    {
      "cab_id": "NYC-4821",
      "zone": "Manhattan-Midtown",
      "status": "dispatched",
      "passengers": 2,
      "fare_usd": 32.50,
      "distance_miles": 8.3,
      "timestamp": "2026-02-10T14:23:01.000Z"
    },
    {
      "cab_id": "NYC-1293",
      "zone": "JFK-Airport",
      "status": "en_route",
      "passengers": 1,
      "fare_usd": 48.75,
      "distance_miles": 14.2,
      "timestamp": "2026-02-10T14:25:30.000Z"
    },
    {
      "cab_id": "NYC-7610",
      "zone": "Brooklyn-Heights",
      "status": "completed",
      "passengers": 3,
      "fare_usd": 12.40,
      "distance_miles": 3.1,
      "timestamp": "2026-02-10T14:28:45.000Z"
    }
  ]
}

